{
  "title": "Portfolio App - Overview",
  "uid": "portfolio-app",
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (by Status)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"portfolio-app\"}[5m])) by (status)"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"portfolio-app\"}[5m])) by (le))"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU Utilization (% of limits)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"dev\", pod=~\"portfolio-app.*\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"dev\", pod=~\"portfolio-app.*\", resource=\"cpu\"}) * 100"
        }
      ]
    },
    {
      "id": 4,
      "title": "HPA Replicas Count",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"dev\", horizontalpodautoscaler=\"portfolio-app\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "AI Agent Calls (Success vs Failure)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (ai_agent_call_total)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Average AI Agent Call Duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(ai_agent_call_duration_seconds)"
        }
      ]
    }
  ]
}
